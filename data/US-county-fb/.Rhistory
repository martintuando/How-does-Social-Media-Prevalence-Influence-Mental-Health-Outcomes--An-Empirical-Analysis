# Definiere die Hauptvariablen
dependent_var <- "Suicide"
endogenous_var <- "twitter_user_unique_ln"
instrument_var <- "twitter_user_sxsw_fol_Mar07_ln"
cons_pre <- "twitter_user_sxsw_fol_pre06_ln"
fixed_effects <- "factor(census_reg) + factor(pop_deciles)"
cluster_var <- "state_code"
# Definiere alle Kontrollvariablensets
cont1 <- c()
cont2 <- c(cont1,"share_20_24", "share_25_29", "share_30_34", "share_35_39", "share_40_44", "share_45_49", "share_50_over", "pop_gr",
"white_pop", "black_pop", "native_pop", "asian_pop", "hispanic_pop",
"bls_unemployment_rate", "census_poverty", "sh_emp_information", "sh_emp_consre", "sh_emp_manufac", "census_o25_highschool", "census_o25_college" )
cont3 <- c(cont2,"Poor_physical_health_days_raw_value", "Adult_obesity_raw_value",
"Frequent_physical_distress_raw_value", "Poor_or_fair_health_raw_value" )
cont4 <- c(cont3,"Uninsured_raw_value", "Primary_care_physicians_raw_value",
"Mental_health_providers_raw_value", "Preventable_hospital_stays_raw_value",
"Uninsured_adults_raw_value", "Uninsured_children_raw_value",
"Health_care_costs_raw_value")
cont5 <- c(cont4,"pop_density", "lnarea", "Food_environment_index_raw_value", "Social_associations_raw_value", "Access_to_exercise_opportunities_raw_value",
"Other_primary_care_providers_raw_value" )
cont6 <- c(cont5,"Adult_smoking_raw_value", "Physical_inactivity_raw_value",
"Excessive_drinking_raw_value", "Insufficient_sleep_raw_value" )
# Eine Liste mit allen Kontrollsets erstellen
control_sets_list <- list("cont1" = cont1, "cont2" = cont2, "cont3" = cont3, "cont4" = cont4, "cont5" = cont5, "cont6" = cont6)
# ====================================================
# REGRESSIONEN DURCHFÜHREN (GETRENNT NACH MODELLTYP)
# ====================================================
### OLS-Regressionen
cat("===================================================\n")
cat("OLS-Regressionen\n")
cat("===================================================\n\n")
for (name in names(control_sets_list)) {
controls <- control_sets_list[[name]]
base_formula <- paste(dependent_var, "~", endogenous_var)
if (length(controls) > 0) {
formula_ols <- paste(base_formula, "+", paste(controls, collapse = " + "), "|", fixed_effects)
} else {
formula_ols <- paste(base_formula, "|", fixed_effects)
}
fit_ols <- feols(as.formula(formula_ols), data = social_media_election, cluster = cluster_var)
cat(paste0("--- Ergebnisse für OLS (", name, ") ---\n"))
print(summary(fit_ols))
cat("\n")
}
### Reduced-Form-Regressionen
cat("===================================================\n")
cat("Reduced-Form-Regressionen\n")
cat("===================================================\n\n")
for (name in names(control_sets_list)) {
controls <- control_sets_list[[name]]
base_formula <- paste(dependent_var, "~", instrument_var, "+", cons_pre)
if (length(controls) > 0) {
formula_rf <- paste(base_formula, "+", paste(controls, collapse = " + "), "|", fixed_effects)
} else {
formula_rf <- paste(base_formula, "|", fixed_effects)
}
fit_rf <- feols(as.formula(formula_rf), data = social_media_election, cluster = cluster_var)
cat(paste0("--- Ergebnisse für Reduced Form (", name, ") ---\n"))
print(summary(fit_rf))
cat("\n")
}
### 2SLS-Regressionen
cat("===================================================\n")
cat("2SLS-Regressionen\n")
cat("===================================================\n\n")
for (name in names(control_sets_list)) {
controls <- control_sets_list[[name]]
base_formula <- paste(dependent_var, "~", cons_pre)
if (length(controls) > 0) {
formula_2sls <- paste(base_formula, "+", paste(controls, collapse = " + "), "|", fixed_effects, "|", endogenous_var, "~", instrument_var)
} else {
formula_2sls <- paste(base_formula, "|", fixed_effects, "|", endogenous_var, "~", instrument_var)
}
fit_2sls <- feols(as.formula(formula_2sls), data = social_media_election, cluster = cluster_var)
cat(paste0("--- Ergebnisse für 2SLS (", name, ") ---\n"))
print(summary(fit_2sls))
cat("\n")
}
