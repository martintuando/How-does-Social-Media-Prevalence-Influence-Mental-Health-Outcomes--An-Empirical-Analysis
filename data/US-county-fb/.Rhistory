# ****************************************************
# NEUE VARIABLE DEFINITION FÜR DUMMY-IV
# ****************************************************
# Deine endogene Variable
endogenous_var <- "sh500m"
# Dein Instrument, die Dummy-Variable
instrument_var <- "id"
# Deine abhängige Variable (Outcome) bleibt gleich
dependent_var <- "Poor_mental_health_days_raw_value"
fixed_effects <- "factor(census_reg) + factor(pop_deciles)"
cluster_var <- "state_code"
# ****************************************************
# ANPASSUNG DER REGRESSIONSFUNKTION
# ****************************************************
# Funktion zum Erstellen der Formel für 2SLS (mit feols-Syntax)
# Die IV-Regression wird in einem einzigen Aufruf durchgeführt, da die Pakete
# die beiden Stufen intern verknüpfen.
create_formula_iv <- function(endogenous_var, instrument_var, controls) {
base_formula <- paste(dependent_var, "~", paste(controls, collapse = " + "), "|",
fixed_effects, "|", endogenous_var, "~", instrument_var)
return(base_formula)
}
# Funktion für die Erste Stufe (zur Überprüfung des Instruments)
create_formula_first_stage <- function(endogenous_var, instrument_var, controls) {
base_formula <- paste(endogenous_var, "~", paste(controls, collapse = " + "), "+", instrument_var, "|", fixed_effects)
return(base_formula)
}
control_sets <- list("cont1" = cont1, "cont2" = cont2, "cont3" = cont3, "cont4" = cont4, "cont5" = cont5, "cont6" = cont6)
results_iv_all <- list()
# Führe 2SLS für alle Kontrollsets aus
for (name in names(control_sets)) {
controls <- control_sets[[name]]
# Führe die 2SLS-Regression aus (mit feols)
formula_iv <- create_formula_iv(endogenous_var, instrument_var, controls)
fit_iv <- feols(as.formula(formula_iv), data = social_media_election, cluster = social_media_election[[cluster_var]])
results_iv_all[[name]] <- fit_iv
print(paste("Ergebnisse der 2SLS-Schätzung für", name))
print(summary(fit_iv))
# Optional: Überprüfung der ersten Stufe (für den F-Wert)
formula_first_stage <- create_formula_first_stage(endogenous_var, instrument_var, controls)
fit_fs <- feols(as.formula(formula_first_stage), data = social_media_election, cluster = social_media_election[[cluster_var]])
print(summary(fit_fs))
}
