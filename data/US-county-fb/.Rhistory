# ****************************************************
# VARIABLEN DEFINITION
# ****************************************************
# Deine endogene Variable
endogenous_var <- "sh500m"
# Dein Instrument, die Dummy-Variable
instrument_var <- "id"
# Deine abhängige Variable (Outcome)
dependent_var <- "Poor_mental_health_days_raw_value"
fixed_effects <- "factor(census_reg) + factor(pop_deciles)"
cluster_var <- "state_code"
# ****************************************************
# ANPASSUNG DER REGRESSIONSFUNKTIONEN
# ****************************************************
# Funktion zum Erstellen der Formel für 2SLS (mit feols-Syntax)
create_formula_iv <- function(endogenous_var, instrument_var, controls) {
base_formula <- paste(dependent_var, "~", paste(controls, collapse = " + "), "|",
fixed_effects, "|", endogenous_var, "~", instrument_var)
return(base_formula)
}
# Funktion für die Erste Stufe (zur Überprüfung des Instruments)
create_formula_first_stage <- function(endogenous_var, instrument_var, controls) {
base_formula <- paste(endogenous_var, "~", paste(controls, collapse = " + "), "+", instrument_var, "|", fixed_effects)
return(base_formula)
}
control_sets <- list("cont1" = cont1, "cont2" = cont2, "cont3" = cont3, "cont4" = cont4, "cont5" = cont5, "cont6" = cont6)
results_iv_all <- list()
results_first_stage_all <- list()
# Führe 2SLS für alle Kontrollsets aus und speichere die Ergebnisse
for (name in names(control_sets)) {
controls <- control_sets[[name]]
# Führe die 2SLS-Regression aus und speichere das Ergebnis
formula_iv <- create_formula_iv(endogenous_var, instrument_var, controls)
fit_iv <- feols(as.formula(formula_iv), data = social_media_election, cluster = social_media_election[[cluster_var]])
results_iv_all[[name]] <- fit_iv
# Führe die Regression der ersten Stufe aus und speichere das Ergebnis
formula_first_stage <- create_formula_first_stage(endogenous_var, instrument_var, controls)
fit_fs <- feols(as.formula(formula_first_stage), data = social_media_election, cluster = social_media_election[[cluster_var]])
results_first_stage_all[[name]] <- fit_fs
}
# Funktion zum Erstellen der Formel für 2SLS (mit feols-Syntax)
create_formula_iv <- function(endogenous_var, instrument_var, controls) {
# Beginnt immer mit der abhängigen Variable
formula_parts <- c(dependent_var, "~")
# Füge Kontrollen nur hinzu, wenn sie vorhanden sind
if (length(controls) > 0) {
formula_parts <- c(formula_parts, paste(controls, collapse = " + "))
}
# Füge die Fixed Effects und IV-Teile hinzu
formula_parts <- c(formula_parts, "|", fixed_effects, "|",
endogenous_var, "~", instrument_var)
return(paste(formula_parts, collapse = " "))
}
# ****************************************************
# Model estimations for dummy variable IV
# ****************************************************
library(haven)
library(fixest)
library(dplyr)
library(AER)
library(sandwich)
library(lmtest)
# Pfad anpassen!
social_media_election <- Regression2014f
# Definiere die Sets der Kontrollvariablen
cont1 <- c()
cont2 <- c(cont1,"share_20_24", "share_25_29", "share_30_34", "share_35_39", "share_40_44", "share_45_49", "share_50_over", "pop_gr",
"white_pop", "black_pop", "native_pop", "asian_pop", "hispanic_pop",
"bls_unemployment_rate", "census_poverty", "sh_emp_information", "sh_emp_consre", "sh_emp_manufac", "census_o25_highschool", "census_o25_college" )
cont3 <- c(cont2,"Poor_physical_health_days_raw_value", "Adult_obesity_raw_value",
"Frequent_physical_distress_raw_value", "Poor_or_fair_health_raw_value" )
cont4 <- c(cont3,"Uninsured_raw_value", "Primary_care_physicians_raw_value",
"Mental_health_providers_raw_value", "Preventable_hospital_stays_raw_value",
"Uninsured_adults_raw_value", "Uninsured_children_raw_value",
"Health_care_costs_raw_value")
cont5 <- c(cont4,"pop_density", "lnarea", "Food_environment_index_raw_value", "Social_associations_raw_value", "Access_to_exercise_opportunities_raw_value",
"Other_primary_care_providers_raw_value" )
cont6 <- c(cont5,"Adult_smoking_raw_value", "Physical_inactivity_raw_value",
"Excessive_drinking_raw_value", "Insufficient_sleep_raw_value"  )
# ****************************************************
# VARIABLEN DEFINITION
# ****************************************************
# Deine endogene Variable
endogenous_var <- "sh500m"
# Dein Instrument, die Dummy-Variable
instrument_var <- "id"
# Deine abhängige Variable (Outcome)
dependent_var <- "Poor_mental_health_days_raw_value"
fixed_effects <- "factor(census_reg) + factor(pop_deciles)"
cluster_var <- "state_code"
# ****************************************************
# ANPASSUNG DER REGRESSIONSFUNKTIONEN
# ****************************************************
# Funktion zum Erstellen der Formel für 2SLS (mit feols-Syntax)
create_formula_iv <- function(endogenous_var, instrument_var, controls) {
# Beginnt immer mit der abhängigen Variable
formula_parts <- c(dependent_var, "~")
# Füge Kontrollen nur hinzu, wenn sie vorhanden sind
if (length(controls) > 0) {
formula_parts <- c(formula_parts, paste(controls, collapse = " + "))
}
# Füge die Fixed Effects und IV-Teile hinzu
formula_parts <- c(formula_parts, "|", fixed_effects, "|",
endogenous_var, "~", instrument_var)
return(paste(formula_parts, collapse = " "))
}
# Funktion für die Erste Stufe (zur Überprüfung des Instruments)
create_formula_first_stage <- function(endogenous_var, instrument_var, controls) {
base_formula <- paste(endogenous_var, "~", paste(controls, collapse = " + "), "+", instrument_var, "|", fixed_effects)
return(base_formula)
}
control_sets <- list("cont1" = cont1, "cont2" = cont2, "cont3" = cont3, "cont4" = cont4, "cont5" = cont5, "cont6" = cont6)
results_iv_all <- list()
results_first_stage_all <- list()
# Führe 2SLS für alle Kontrollsets aus und speichere die Ergebnisse
for (name in names(control_sets)) {
controls <- control_sets[[name]]
# Führe die 2SLS-Regression aus und speichere das Ergebnis
formula_iv <- create_formula_iv(endogenous_var, instrument_var, controls)
fit_iv <- feols(as.formula(formula_iv), data = social_media_election, cluster = social_media_election[[cluster_var]])
results_iv_all[[name]] <- fit_iv
# Führe die Regression der ersten Stufe aus und speichere das Ergebnis
formula_first_stage <- create_formula_first_stage(endogenous_var, instrument_var, controls)
fit_fs <- feols(as.formula(formula_first_stage), data = social_media_election, cluster = social_media_election[[cluster_var]])
results_first_stage_all[[name]] <- fit_fs
}
